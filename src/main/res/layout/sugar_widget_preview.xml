<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sugar"
            android:textColor="#2B1B20"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/sw_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="#E5384F"
            android:textStyle="bold"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sw_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/sw_n1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="7dp"
                android:background="@drawable/note_card"
                android:padding="4dp">
                <TextView
                    android:id="@+id/sw_t1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:textColor="#2B1B20"
                    android:textSize="12sp"
                    android:maxLines="4"
                    android:ellipsize="end" android:text="اشتري لبن وبيض" android:background="@drawable/note_bg_0" />
            </LinearLayout>
            <ImageView
                android:id="@+id/sw_p1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|center_horizontal" android:src="@drawable/pin_0" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/sw_n2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="7dp"
                android:background="@drawable/note_card"
                android:padding="4dp">
                <TextView
                    android:id="@+id/sw_t2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:textColor="#2B1B20"
                    android:textSize="12sp"
                    android:maxLines="4"
                    android:ellipsize="end" android:text="عليا بكرا امتحان" android:background="@drawable/note_bg_1" />
            </LinearLayout>
            <ImageView
                android:id="@+id/sw_p2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|center_horizontal" android:src="@drawable/pin_1" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sw_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/sw_n3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="7dp"
                android:background="@drawable/note_card"
                android:padding="4dp">
                <TextView
                    android:id="@+id/sw_t3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:textColor="#2B1B20"
                    android:textSize="12sp"
                    android:maxLines="4"
                    android:ellipsize="end" android:text="Call the dentist" android:background="@drawable/note_bg_2" />
            </LinearLayout>
            <ImageView
                android:id="@+id/sw_p3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|center_horizontal" android:src="@drawable/pin_2" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/sw_n4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="7dp"
                android:background="@drawable/note_card"
                android:padding="4dp">
                <TextView
                    android:id="@+id/sw_t4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:textColor="#2B1B20"
                    android:textSize="12sp"
                    android:maxLines="4"
                    android:ellipsize="end" android:text="مذاكرة الجافا" android:background="@drawable/note_bg_3" />
            </LinearLayout>
            <ImageView
                android:id="@+id/sw_p4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|center_horizontal" android:src="@drawable/pin_3" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sw_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/sw_n5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="7dp"
                android:background="@drawable/note_card"
                android:padding="4dp">
                <TextView
                    android:id="@+id/sw_t5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:textColor="#2B1B20"
                    android:textSize="12sp"
                    android:maxLines="4"
                    android:ellipsize="end" android:text="Buy flowers" android:background="@drawable/note_bg_4" />
            </LinearLayout>
            <ImageView
                android:id="@+id/sw_p5"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|center_horizontal" android:src="@drawable/pin_4" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/sw_n6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="7dp"
                android:background="@drawable/note_card"
                android:padding="4dp">
                <TextView
                    android:id="@+id/sw_t6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:textColor="#2B1B20"
                    android:textSize="12sp"
                    android:maxLines="4"
                    android:ellipsize="end" android:text="فاتورة النت" android:background="@drawable/note_bg_5" />
            </LinearLayout>
            <ImageView
                android:id="@+id/sw_p6"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|center_horizontal" android:src="@drawable/pin_5" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
